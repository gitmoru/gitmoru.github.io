---
/**
 * 복사해서 쓰는 명령.
 *
 * 링크로 저장소에 보내는 대신 명령을 그대로 준다.
 * 이 도구를 켜는 사람은 이미 터미널 앞에 앉아 있다.
 */

import { t } from '../i18n/ui'
import { langOf, type Lang } from '../i18n/config'

interface Props {
  code: string
  class?: string
}

const { code, class: cls } = Astro.props
// 주소로 언어를 읽는다. 쓰는 쪽마다 lang 을 넘기게 하면 한 군데는 반드시 빠뜨린다.
const ui = t(langOf(Astro.url.pathname) as Lang)
---

<div class:list={['px min-w-0 bg-[var(--color-ink)]', cls]} style="--px-c: var(--color-edge)">
  <div class="flex items-start gap-3 p-4">
    {/*
      좁은 화면에서는 긴 줄이 그냥 잘려 보인다. 잘린 건지 끝난 건지 알 수가 없다.
      글자를 줄이고, 오른쪽 끝에 그늘을 둬서 "더 있다" 를 보이게 한다.
      줄바꿈은 안 한다. 셸 명령이 접히면 그것대로 잘못 읽힌다.
    */}
    <pre
      class="cmd min-w-0 flex-1 overflow-x-auto font-mono text-[12px] leading-relaxed whitespace-pre sm:text-[13px]"><code>{code}</code></pre>
    <button
      type="button"
      class="shrink-0 px-2 py-1 font-mono text-[11px] text-[var(--color-faint)] transition-colors hover:text-[var(--color-moss)]"
      data-copy={code}
      data-copied={ui.nav.copied}
    >
      {ui.nav.copy}
    </button>
  </div>
</div>

<style>
  /* 오른쪽에 더 있다는 표시. 스크롤 끝에 닿으면 자연스럽게 옅어진다 */
  .cmd {
    mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
  }
  .cmd::-webkit-scrollbar {
    height: 6px;
  }
  .cmd::-webkit-scrollbar-thumb {
    background: var(--color-edge);
  }
</style>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '')
      const before = btn.textContent
      btn.textContent = btn.dataset.copied ?? 'Copied'
      setTimeout(() => (btn.textContent = before), 1600)
    })
  }
</script>
