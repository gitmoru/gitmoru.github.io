---
/**
 * 제품이 실제로 뱉은 글.
 *
 * 여기 들어가는 건 전부 **진짜 출력**이다. 보기 좋으라고 손보지 않는다.
 * 손보는 순간 "이렇게 나올 겁니다" 가 되고, 그건 우리가 제일 싫어하는 종류의 문장이다.
 */

interface Props {
  label: string
  code: string
  class?: string
}

const { label, code, class: cls } = Astro.props
---

{/*
  min-w-0 이 필요하다. 격자나 flex 안에 들어가면 자식의 기본 최소 너비가 auto 라,
  안에 든 `<pre>` 의 가장 긴 줄만큼 칸이 벌어진다. 좁은 화면에서 페이지가 통째로 넘친다.
*/}
<figure class:list={['px min-w-0 bg-[var(--color-ink)]', cls]} style="--px-c: var(--color-edge)">
  <figcaption
    class="border-b border-[var(--color-edge-soft)] px-4 py-2 font-mono text-[11px] text-[var(--color-faint)]"
  >
    {label}
  </figcaption>
  <pre
    class="overflow-x-auto p-4 font-mono text-[12.5px] leading-[1.75] whitespace-pre"><code>{code}</code></pre>
</figure>
