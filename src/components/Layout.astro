---
import '../styles/tokens.css'
import Nav from './Nav.astro'
import Footer from './Footer.astro'
import { DEFAULT_LANG, HREFLANG, LANGS, href, type Lang, type PagePath } from '../i18n/config'
import { t } from '../i18n/ui'
import { VERIFY } from '../i18n/verify'

interface Props {
  lang: Lang
  page: PagePath
  title: string
  description: string
  /** 지층 색. 페이지마다 다른 깊이에 있는 것처럼 보이게 한다 */
  tone?: string
}

const { lang, page, title, description, tone = 'var(--color-ink)' } = Astro.props
const site = Astro.site ?? new URL('https://gitmoru.dev')
const canonical = new URL(href(lang, page), site).href

/*
  언어마다 다른 주소를 주고 서로를 가리키게 한다.

  한 주소에서 자바스크립트로 말만 바꾸면 검색 결과에는 한 언어만 남는다.
  x-default 는 "어느 것도 안 맞으면 여기" 라는 뜻이라 기본 언어를 준다.
*/
const alternates = LANGS.map((l) => ({
  hreflang: HREFLANG[l],
  href: new URL(href(l, page), site).href,
}))
---

<!doctype html>
<html lang={HREFLANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(href(DEFAULT_LANG, page), site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={HREFLANG[lang].replace('-', '_')} />
    {/*
      공유 카드.

      워드마크 SVG 를 걸어뒀더니 슬랙에도 카카오톡에도 빈 카드가 떴다.
      **대부분의 메신저는 SVG 를 안 그린다.** 1200x630 PNG 여야 한다.
      언어마다 다른 카드를 쓴다. `pnpm og` 가 사이트 화면을 그대로 찍어 만든다.
    */}
    <meta property="og:image" content={new URL(`/og-${lang}.png`, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="gitmoru" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(`/og-${lang}.png`, site).href} />

    {/* 값이 든 것만 내보낸다. 빈 태그는 확인이 안 되는데도 된 줄 알게 만든다. */}
    {
      Object.entries(VERIFY)
        .filter(([, code]) => code)
        .map(([name, code]) => <meta name={name} content={code} />)
    }

    <link rel="icon" type="image/svg+xml" href="/mole.svg" />

    {/*
      검색 엔진에 무엇인지 알려준다.

      개발자 도구이고, 공짜이고, 어느 운영체제에서 도는지까지 적는다.
      광고 문구를 넣지 않는다. 여기 적은 게 화면에 있는 것과 다르면 그게 곧 낚시다.
    */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'gitmoru',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Windows, macOS, Linux',
        description,
        url: canonical,
        inLanguage: HREFLANG[lang],
        license: 'https://opensource.org/licenses/MIT',
        codeRepository: 'https://github.com/gitmoru/gitmoru',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      })}
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5/index.min.css"
    />
  </head>

  <body style={`background: ${tone}`}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-[var(--color-moss)] focus:px-4 focus:py-2 focus:text-[#16241c]"
    >
      {t(lang).nav.menu}
    </a>

    <Nav lang={lang} page={page} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
