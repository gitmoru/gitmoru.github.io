---
import { framesToHtml } from '../lib/mole'
import * as S from '../lib/sprites'

/**
 * 모루.
 *
 * 프레임을 빌드할 때 SVG 로 구워서 HTML 에 박는다. 그리는 데 드는 스크립트가 0이고,
 * 자바스크립트가 꺼져 있어도 첫 장은 그대로 보인다.
 *
 * **흙 위에 그냥 얹으면 안 보인다.** 몸통이 `#6f5442`, 표토가 `#6d5138` 이라
 * 명도 대비가 1.05 다. 거의 같은 색이다. 앱에서는 모루가 굴 안에 있어서 이 문제가 없었다.
 *
 * 상자를 깔아서 가리는 방법을 먼저 해봤는데, 캐릭터가 액자에 갇힌 것처럼 어색했다.
 * 지금은 실루엣에 테두리를 두른다 (`mole.ts`). 도트 게임이 원래 쓰는 방법이고,
 * 배경 위에 그냥 올려둬도 형체가 남는다.
 */

const SEQ = {
  idle: S.SEQ_IDLE,
  dig: S.SEQ_DIG,
  peek: S.SEQ_PEEK,
  wave: S.SEQ_WAVE,
  look: S.SEQ_LOOK,
  found: S.SEQ_FOUND,
  shake: S.SEQ_SHAKE,
  carry: S.SEQ_CARRY,
  nod: S.SEQ_NOD,
} as const

interface Props {
  motion?: keyof typeof SEQ
  scale?: number
  ms?: number
  label?: string
  class?: string
}

const { motion = 'idle', scale = 6, ms = 380, label = '모루', class: cls } = Astro.props

const html = framesToHtml(SEQ[motion] as string[][], { scale, ms, label })
---

<span class={cls} set:html={html} />

<script>
  /*
    프레임 넘기기.

    부드럽게 섞지 않는다. 도트 애니메이션은 한 장에서 다음 장으로 딱 넘어가야 한다.
    화면 밖에 있으면 멈춘다. 움직임을 줄여달라고 한 사람에게는 아예 안 돌린다.
  */
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!still) {
    for (const box of document.querySelectorAll<HTMLElement>('[data-mole]')) {
      const frames = [...box.children] as HTMLElement[]
      if (frames.length < 2) continue

      const ms = Number(box.dataset.ms) || 380
      let at = 0
      let timer: ReturnType<typeof setInterval> | null = null

      const tick = () => {
        frames[at]?.setAttribute('hidden', '')
        at = (at + 1) % frames.length
        frames[at]?.removeAttribute('hidden')
      }

      new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !timer) timer = setInterval(tick, ms)
          else if (!e.isIntersecting && timer) {
            clearInterval(timer)
            timer = null
          }
        }
      }).observe(box)
    }
  }
</script>
