---
/**
 * 지층 하나 = 섹션 하나.
 *
 * 이 사이트의 세로축은 깊이다. 아래로 갈수록 흙이 어두워지고,
 * 경계마다 밝은 줄이 그어진다. 앱 화면 아래에서 모루가 파고 다니는 그 땅을
 * 그대로 세워 놓은 것이다.
 *
 * 깊이 값은 장식이 아니라 오른쪽 깊이계가 읽는 값이다.
 */

interface Props {
  /** 오른쪽 깊이계에 뜨는 값 */
  depth: string
  /** 이 지층의 이름 */
  layer: string
  /** 흙 색 단계. 위에서 아래로 짙어진다 */
  tone: 0 | 1 | 2 | 3 | 'rock'
  /** 맨 위 지층은 경계선을 안 긋는다 */
  first?: boolean
  id?: string
}

const { depth, layer, tone, first, id } = Astro.props

const SOIL = {
  0: 'var(--color-soil-0)',
  1: 'var(--color-soil-1)',
  2: 'var(--color-soil-2)',
  3: 'var(--color-soil-3)',
  rock: 'var(--color-tunnel)',
} as const
---

<section
  id={id}
  data-depth={depth}
  data-layer={layer}
  class:list={['relative overflow-hidden', !first && 'stratum']}
  style={`background: ${SOIL[tone]}`}
>
  <div class="grit pointer-events-none absolute inset-0"></div>
  <div class="relative mx-auto max-w-5xl px-6 py-24 md:py-32">
    <slot />
  </div>
</section>
