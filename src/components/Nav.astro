---
import { href, LANG_NAME, LANGS, type Lang, type PagePath } from '../i18n/config'
import { t } from '../i18n/ui'
import LangPicker from './LangPicker.astro'
import { frameToSvg } from '../lib/mole'
import { SEQ_MOUND, SEQ_PEEK } from '../lib/sprites'

interface Props {
  lang: Lang
  page: PagePath
}

const { lang, page } = Astro.props
const ui = t(lang)

const ITEMS: Array<[PagePath, string]> = [
  ['why', ui.nav.why],
  ['how', ui.nav.how],
  ['start', ui.nav.start],
  ['mcp', ui.nav.mcp],
]

/*
  스토리는 여기 없다.

  내비게이션에 두면 시작하기, 왜 판정 안 하나와 같은 무게가 된다.
  새벽에 온 사람에게 만든 사람의 사연은 같은 무게일 수가 없다.
  게다가 결정적인 대목은 이미 왜 판정 안 하나에 들어가 있다.

  읽고 싶어지는 자리는 따로 있다. 그 사연을 읽고 "이 사람들 뭘 겪은 거지" 가 되는 순간이다.
  그래서 왜 판정 안 하나의 끝과 바닥글에서만 이어준다.
*/

/*
  내비게이션 밑을 모루가 파고 다닌다.

  지금 보고 있는 자리에서 머리를 내밀고 있다가, 다른 항목을 가리키면
  **머리를 땅속으로 집어넣고** 흙을 밀며 그쪽으로 간 다음 다시 올라온다.

  중간 단계를 생략하고 머리에서 흙으로 그냥 바꾸면, 파고 들어간 게 아니라
  그림이 갈아끼워진 것으로 보인다. 들어가고 나오는 걸 다 그려야 굴로 읽힌다.

  빼꼼 동작이 이미 세 칸짜리 오르내림이라 그대로 쓴다.
  0번이 제일 깊고 2번이 제일 높다. 들어갈 때는 거꾸로 재생한다.
*/
const HEAD = SEQ_PEEK.map((f) => frameToSvg(f, { scale: 2 }))
// 흙에는 테두리를 안 두른다. 캐릭터가 아니라 흙이다.
const DIRT = SEQ_MOUND.map((f) => frameToSvg(f, { scale: 2, outline: false }))
---

<header
  class="sticky top-0 z-30 border-b border-[var(--color-edge-soft)] bg-[var(--color-ink)]/92 backdrop-blur"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-5">
    <a
      href={href(lang)}
      class="shrink-0 px-1 py-1 opacity-90 transition-opacity hover:opacity-100"
      aria-label="gitmoru"
    >
      <img src="/wordmark.svg" alt="gitmoru" width="104" height="33" data-pixel />
    </a>

    <nav
      class="relative hidden min-w-0 flex-1 items-center gap-1 md:flex"
      aria-label={ui.nav.menu}
      data-burrow-nav
    >
      {
        ITEMS.map(([to, label]) => (
          <a
            href={href(lang, to)}
            data-nav-item
            aria-current={page === to ? 'page' : undefined}
            class:list={[
              'group relative px-3 py-2 text-[13.5px] whitespace-nowrap transition-colors',
              page === to
                ? 'text-[var(--color-sand)]'
                : 'text-[var(--color-muted)] hover:text-[var(--color-text)]',
            ]}
          >
            {label}
            {/*
              모루가 뚫고 올라오는 자리.

              지금 보고 있는 항목은 모래색으로 열려 있고, 가리킨 항목은 흙색으로 옅게 열린다.
              모루가 어디로 갈지 먼저 보이는 셈이라, 이동이 갑작스럽지 않다.
            */}
            <span
              class:list={[
                'absolute right-2 bottom-0 left-2 h-[3px] transition-colors',
                page === to
                  ? 'bg-[var(--color-sand)]'
                  : 'bg-transparent group-hover:bg-[var(--color-soil-line)]',
              ]}
              aria-hidden="true"
            />
          </a>
        ))
      }

      <!--
        모루는 항목마다 그리지 않고 하나만 두고 옮긴다.
        항목마다 그려두면 옮겨 다니는 게 아니라 여러 마리가 깜빡이는 것으로 보인다.
        자바스크립트가 없으면 지금 자리에 가만히 머리를 내밀고 있다.
      -->
      <span
        class="pointer-events-none absolute -bottom-[9px] hidden"
        data-burrow-mole
        aria-hidden="true"
      >
        {
          HEAD.map((f, i) => (
            <span class="col-start-1 row-start-1" data-mole-head hidden={i !== 2} set:html={f} />
          ))
        }
        {
          DIRT.map((f, i) => (
            <span class="col-start-1 row-start-1" data-mole-dirt hidden set:html={f} />
          ))
        }
      </span>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2">
      <LangPicker lang={lang} page={page} />

      <a
        href="https://github.com/gitmoru/gitmoru"
        class="hidden px-2.5 py-1.5 text-[12.5px] text-[var(--color-muted)] transition-colors hover:bg-white/5 hover:text-[var(--color-text)] md:block"
      >
        {ui.nav.github}
      </a>

      <!--
        여닫는 단추. 도트 세 줄이라 둥글리지 않는다.
        열리면 가운데 줄이 사라지고 위아래가 모여서 X 가 된다.
      -->
      <button
        type="button"
        class="menu-btn -mr-1 grid h-9 w-9 place-items-center md:hidden"
        aria-controls="menu"
        aria-expanded="false"
        aria-label={ui.nav.menu}
        data-menu-btn
      >
        <span class="grid gap-[5px]">
          <span class="menu-bar block h-[3px] w-[19px] bg-[var(--color-muted)]"></span>
          <span class="menu-bar block h-[3px] w-[19px] bg-[var(--color-muted)]"></span>
          <span class="menu-bar block h-[3px] w-[19px] bg-[var(--color-muted)]"></span>
        </span>
      </button>
    </div>
  </div>

  <!--
    좁은 화면에서 여는 메뉴.

    예전에는 항목을 가로로 밀어 보게 했는데, 화면 아래쪽에 늘 한 줄이 눌러앉아
    본문을 밀어냈고 오른쪽 항목은 밀어야 보였다. 있는 줄도 모르고 지나간다.

    여는 방식은 흙을 걷어내는 모양으로 한다. `clip-path` 를 몇 칸으로 끊어서
    위에서 아래로 파내려간다. 스르륵 내려오면 이 사이트의 다른 움직임과 결이 달라진다.
  -->
  <div
    id="menu"
    class="menu-sheet overflow-hidden border-b-[3px] border-[var(--color-soil-line)] bg-[var(--color-ink)] md:hidden"
    data-menu
    hidden
  >
    <nav class="px-5 pt-1 pb-3" aria-label={ui.nav.menu}>
      {
        ITEMS.map(([to, label]) => (
          <a
            href={href(lang, to)}
            aria-current={page === to ? 'page' : undefined}
            class:list={[
              'relative flex items-center justify-between py-3 text-[15px]',
              page === to ? 'text-[var(--color-sand)]' : 'text-[var(--color-muted)]',
            ]}
          >
            <span>{label}</span>
            {page === to && <span class="pr-1" set:html={HEAD[2]} />}
          </a>
        ))
      }

      <a
        href="https://github.com/gitmoru/gitmoru"
        class="flex py-3 text-[15px] text-[var(--color-muted)]"
      >
        {ui.nav.github}
      </a>
    </nav>
  </div>
</header>

<style>
  /*
    흙을 걷어내듯 위에서 아래로 열린다.
    부드럽게 늘어나지 않고 네 칸으로 끊어서 파내려간다.
  */
  .menu-sheet {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 220ms steps(4, end);
  }
  .menu-sheet[data-open] {
    clip-path: inset(0 0 0 0);
  }

  /* 열리면 가운데 줄이 사라지고 위아래가 모여 X 가 된다 */
  .menu-bar {
    transition:
      transform 120ms steps(2, end),
      opacity 120ms steps(2, end);
  }
  [aria-expanded='true'] .menu-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  [aria-expanded='true'] .menu-bar:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded='true'] .menu-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-sheet,
    .menu-bar {
      transition: none;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')
  const sheet = document.querySelector<HTMLElement>('[data-menu]')

  if (btn && sheet) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open))
      if (open) {
        sheet.hidden = false
        // 숨김을 푼 직후에 열면 브라우저가 시작 상태를 못 잡아 그냥 나타난다
        requestAnimationFrame(() => sheet.setAttribute('data-open', ''))
      } else {
        sheet.removeAttribute('data-open')
        setTimeout(() => {
          if (btn.getAttribute('aria-expanded') === 'false') sheet.hidden = true
        }, 240)
      }
    }

    btn.addEventListener('click', () =>
      setOpen(btn.getAttribute('aria-expanded') !== 'true'),
    )

    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false)
        btn.focus()
      }
    })

    // 항목을 누르면 페이지가 바뀐다. 열린 채로 두면 다음 화면에서 잠깐 겹쳐 보인다.
    for (const link of sheet.querySelectorAll('a')) {
      link.addEventListener('click', () => setOpen(false))
    }
  }

  const nav = document.querySelector<HTMLElement>('[data-burrow-nav]')
  const mole = nav?.querySelector<HTMLElement>('[data-burrow-mole]')

  if (nav && mole) {
    const items = [...nav.querySelectorAll<HTMLAnchorElement>('[data-nav-item]')]
    const heads = [...mole.querySelectorAll<HTMLElement>('[data-mole-head]')]
    const dirt = [...mole.querySelectorAll<HTMLElement>('[data-mole-dirt]')]
    const home = items.find((a) => a.getAttribute('aria-current') === 'page')

    // 지금 페이지가 내비게이션에 없으면(홈, 404) 나올 자리도 없다
    if (home) {
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches

      /** 한 칸 오르내리는 데 걸리는 시간. 세 칸이라 들어가고 나오는 데 각각 세 배 */
      const STEP = 60
      const TRAVEL = 240

      mole.classList.remove('hidden')
      mole.classList.add('grid')

      const settle = (el: HTMLElement) => {
        mole.style.left = `${el.offsetLeft + el.offsetWidth / 2 - mole.offsetWidth / 2}px`
      }

      /** 머리 세 칸 중 하나만, 또는 흙 한 장만 보이게 한다 */
      const show = (kind: 'head' | 'dirt', at: number) => {
        heads.forEach((el, i) => (el.hidden = kind !== 'head' || i !== at))
        dirt.forEach((el, i) => (el.hidden = kind !== 'dirt' || i !== at))
      }

      // 자리를 먼저 잡고 나서 움직임을 켠다. 안 그러면 처음 뜰 때 왼쪽 끝에서 미끄러져 온다.
      settle(home)
      requestAnimationFrame(() => {
        if (!still) mole.style.transition = `left ${TRAVEL}ms steps(6, end)`
      })

      let timers: Array<ReturnType<typeof setTimeout>> = []
      let cycling: ReturnType<typeof setInterval> | null = null
      let at: HTMLElement = home

      const clearAll = () => {
        timers.forEach(clearTimeout)
        timers = []
        if (cycling) {
          clearInterval(cycling)
          cycling = null
        }
      }

      const later = (ms: number, fn: () => void) => timers.push(setTimeout(fn, ms))

      /**
       * 들어가고, 가고, 나온다.
       *
       * 세 단계를 다 그리는 게 요점이다. 가운데를 건너뛰면 굴이 아니라 그림 교체로 보인다.
       */
      const goTo = (target: HTMLElement) => {
        if (target === at) return
        clearAll()
        at = target

        if (still) {
          settle(target)
          show('head', 2)
          return
        }

        // 1. 머리를 집어넣는다 (위 -> 아래)
        show('head', 1)
        later(STEP, () => show('head', 0))

        // 2. 땅속에서 흙을 밀며 간다
        later(STEP * 2, () => {
          show('dirt', 0)
          settle(target)
          let f = 0
          cycling = setInterval(() => {
            f = (f + 1) % dirt.length
            show('dirt', f)
          }, 110)
        })

        // 3. 도착하고 나서 올라온다 (아래 -> 위)
        later(STEP * 2 + TRAVEL, () => {
          if (cycling) {
            clearInterval(cycling)
            cycling = null
          }
          show('head', 0)
        })
        later(STEP * 3 + TRAVEL, () => show('head', 1))
        later(STEP * 4 + TRAVEL, () => show('head', 2))
      }

      for (const item of items) {
        item.addEventListener('mouseenter', () => goTo(item))
        item.addEventListener('focus', () => goTo(item))
      }

      nav.addEventListener('mouseleave', () => goTo(home))
      addEventListener('resize', () => settle(at), { passive: true })
    }
  }
</script>
