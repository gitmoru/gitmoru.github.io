---
import Layout from '../components/Layout.astro'
import Band from '../components/Band.astro'
import PageHead from '../components/PageHead.astro'
import Command from '../components/Command.astro'
import { href, type Lang } from '../i18n/config'
import { t } from '../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props
const ui = t(lang)
const s = ui.start

/*
  갈래가 둘이다.

  화면만 보면 되는 사람은 Node 와 gh 만 있으면 된다. 되돌리기까지 하려면 클론이
  필요하고 거기에 pnpm 이 붙는다. 예전에는 셋을 한 덩어리로 적어뒀는데,
  그건 급한 사람한테 pnpm 부터 깔고 오라는 말이었다.
*/
const NEEDS = [
  ['Node 22+', 'https://nodejs.org'],
  ['GitHub CLI', 'https://cli.github.com'],
]

const QUICK = `gh auth login
npx -y gitmoru`

const CLONE = `git clone https://github.com/gitmoru/gitmoru.git
cd gitmoru
gh auth login
pnpm install
pnpm app`

const NPM = 'https://www.npmjs.com/package/gitmoru'
const BADGE = 'px inline-block bg-[var(--color-ink)] px-4 py-2 text-[14px] hover:text-[var(--color-moss)]'
---

<Layout lang={lang} page="start" title={s.seoTitle} description={s.seoDesc} tone="var(--color-soil-2)">
  <Band tone={2} grit>
    <PageHead title={s.h1} motion="wave" />
  </Band>

  <Band tone={3} grit edge>
    <h2 class="text-[22px] font-bold md:text-[28px]">{s.needTitle}</h2>
    <ul class="mt-6 flex flex-wrap gap-3">
      {NEEDS.map(([name, url]) => (
        <li>
          <a href={url} class={BADGE} style="--px-c: var(--color-soil-line)">{name}</a>
        </li>
      ))}
    </ul>
    <p class="mt-8 mb-3 text-[13.5px] text-[var(--color-muted)]">{s.needCheck}</p>
    <Command class="max-w-2xl" code="node -v && gh --version" />

    {/*
      짧은 쪽을 먼저 놓는다.

      여기 오는 사람은 이미 사고가 난 뒤다. 그 사람이 먼저 봐야 하는 건
      화면을 띄우는 두 줄이지, 클론하고 설치하는 다섯 줄이 아니다.
    */}
    <h2 class="mt-20 text-[22px] font-bold md:text-[28px]">{s.quickTitle}</h2>
    <p class="mt-5 max-w-2xl text-[16px] leading-relaxed text-[#e5dcd0]">{s.quickLede}</p>
    <Command class="mt-6 max-w-2xl" code={QUICK} />
    <p class="mt-4 max-w-2xl text-[14.5px] leading-relaxed text-[var(--color-muted)]">
      {s.quickNote}{' '}
      <a href={NPM} class="text-[var(--color-moss)] hover:underline">{s.npmLink} →</a>
    </p>

    <h2 class="mt-20 text-[22px] font-bold md:text-[28px]">{s.fullTitle}</h2>
    <p class="mt-5 max-w-2xl text-[16px] leading-relaxed text-[#e5dcd0]">{s.fullLede}</p>
    <p class="mt-6 mb-3 text-[13.5px] text-[var(--color-muted)]">{s.fullNeed}</p>
    <a href="https://pnpm.io" class={BADGE} style="--px-c: var(--color-soil-line)">pnpm</a>
    <Command class="mt-6 max-w-2xl" code={CLONE} />

    <h2 class="mt-20 text-[22px] font-bold md:text-[28px]">{s.afterTitle}</h2>
    <p class="mt-5 max-w-2xl text-[16px] leading-relaxed text-[#e5dcd0]">{s.after1}</p>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-[var(--color-muted)]">{s.after2}</p>
  </Band>

  <Band tone="rock" edge>
    <h2 class="text-[22px] font-bold md:text-[28px]">{s.stuckTitle}</h2>
    <ul class="mt-8 space-y-px overflow-hidden" style="background: var(--color-edge-soft)">
      {s.stuck.map(([name, what]) => (
        <li class="bg-[var(--color-ink)] p-5">
          <p class="font-mono text-[14px]" style="color: var(--color-sand)">{name}</p>
          <p class="mt-2 text-[14.5px] leading-relaxed text-[var(--color-muted)]">{what}</p>
        </li>
      ))}
    </ul>

    <div class="px mt-16 max-w-3xl bg-black/25 p-6" style="--px-c: var(--color-edge)">
      <h2 class="text-[18px] font-semibold">{s.noInstallerTitle}</h2>
      <p class="mt-4 text-[15px] leading-relaxed text-[var(--color-muted)]">{s.noInstaller1}</p>
      <p class="mt-3 text-[15px] leading-relaxed text-[var(--color-muted)]">{s.noInstaller2}</p>
    </div>

    <h2 class="mt-20 text-[22px] font-bold md:text-[28px]">{s.factTitle}</h2>
    <dl class="mt-8 grid gap-6 md:grid-cols-2">
      {s.facts.map(([name, what]) => (
        <div>
          <dt class="text-[15.5px] font-semibold">{name}</dt>
          <dd class="mt-1.5 text-[14px] leading-relaxed text-[var(--color-muted)]">{what}</dd>
        </div>
      ))}
    </dl>

    {/*
      팀에 알리기.

      혼자 훑고 끝나는 도구가 아니다. 계정마다 보이는 범위가 달라서
      한 사람의 결과가 전부가 아닌데, 그 사실을 아무도 안 알려준다.
      그래서 붙여넣을 글까지 여기서 준다. 매번 다시 쓰게 두면 결국 안 알리게 된다.
    */}
    <h2 class="mt-20 text-[22px] font-bold md:text-[28px]">{s.teamTitle}</h2>
    <p class="mt-5 max-w-2xl text-[16px] leading-relaxed text-[#e5dcd0]">{s.teamLede}</p>

    <p class="mt-8 mb-3 text-[13.5px] text-[var(--color-muted)]">{s.teamCopy}</p>
    <Command class="max-w-2xl" code={s.teamMessage} />

    <p
      class="px mt-6 max-w-2xl bg-black/25 p-4 text-[14px] leading-relaxed"
      style="--px-c: var(--color-sand); color: var(--color-sand)"
    >
      {s.teamNote}
    </p>

    <a href={href(lang, 'mcp')} class="mt-12 inline-block text-[15px] text-[var(--color-moss)] hover:underline">
      {s.next} →
    </a>
  </Band>
</Layout>
