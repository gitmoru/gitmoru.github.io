---
import Layout from '../components/Layout.astro'
import Band from '../components/Band.astro'
import Command from '../components/Command.astro'
import Mole from '../components/Mole.astro'
import Output from '../components/Output.astro'
import Shot from '../components/Shot.astro'
import { href, type Lang } from '../i18n/config'
import { t } from '../i18n/ui'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const ui = t(lang)
const h = ui.home

/*
  히어로 옆에 놓는 건 실제 공유문의 일부다.

  화면 사진을 넣고 싶은 자리인데, 지금 있는 진짜 산출물이 이 글이라서 이걸 쓴다.
  실물 대신 그럴듯한 목업을 그려 넣는 순간 이 사이트도 우리가 싫어하는 부류가 된다.

  **언어를 따라간다.** 예전에는 한국어가 박혀 있어서 영어판에도 한국어가 떴다.
  제품이 세 언어로 말하는데 사이트가 한 언어만 보여주면 그 번역이 거짓말이 된다.
*/

/** 받아서 켜는 다섯 줄. 첫 화면에서 바로 복사할 수 있어야 한다. */
const CLONE = `git clone https://github.com/gitmoru/gitmoru.git
cd gitmoru
gh auth login
pnpm install
pnpm app`
---

<Layout lang={lang} page="" title={`gitmoru - ${h.title}`} description={h.desc}>
  <!-- ── 지표 ─────────────────────────────────────────── -->
  <div class="relative overflow-hidden bg-[var(--color-ink)]">
    <div class="mx-auto grid max-w-6xl gap-14 px-5 pt-14 pb-20 lg:grid-cols-[1.05fr_1fr] lg:pt-20">
      <div>
        <!-- 줄 나누기는 balance 가 한다. 강조할 조각만 언어별로 정해져 있다. -->
        <h1 class="text-[36px] leading-[1.2] font-bold md:text-[54px]">
          {h.h1.map((part) => (
            <span style={part.hl ? 'color: var(--color-apricot)' : undefined}>{part.t}</span>
          ))}
        </h1>

        <p class="mt-7 max-w-lg text-[17px] leading-relaxed text-[var(--color-muted)]">
          {h.lede}
        </p>

        {/*
          상황을 묻는 갈림길.

          이 도구를 여는 사람은 두 부류로 갈린다. 지금 사고가 난 사람과, 알아보러 온 사람이다.
          앞쪽은 1초라도 빨리 켜야 하고, 뒤쪽은 읽을 시간이 있다.
        */}
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href={href(lang, 'start')}
            class="px-btn bg-[var(--color-moss)] px-6 py-3.5 text-[15.5px] font-semibold text-[#16241c]"
            style="--px-c: var(--color-moss)"
          >
            {h.forkNow}
          </a>
          <a
            href={href(lang, 'why')}
            class="px-btn px-6 py-3.5 text-[15.5px] text-[var(--color-muted)] transition-colors hover:text-[var(--color-text)]"
            style="--px-c: var(--color-edge)"
          >
            {h.forkLook}
          </a>
        </div>
      </div>

      {/*
        받아서 켜는 다섯 줄.

        급한 사람이 버튼을 눌러 다음 화면으로 가서 하는 일이 결국 이걸 복사하는 것이다.
        그러면 첫 화면에서 준다. 버튼은 자세한 순서가 필요한 사람을 위해 남겨둔다.

        제품이 뭐라고 말하는지 보여주는 상자는 아래 띠로 내렸다.
        첫 화면에 모루 머리까지 들어와야 "여기서부터 땅속" 이 한눈에 읽힌다.
      */}
      <div class="min-w-0 lg:pt-2">
        <Command code={CLONE} />
        <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px]">
          <span class="text-[var(--color-faint)]">{h.quickNote}</span>
          <a href={href(lang, 'start')} class="text-[var(--color-moss)] hover:underline">
            {h.quickMore} →
          </a>
        </div>
      </div>
    </div>

    <!-- 여기서부터 땅속. 모루가 그 경계에서 올라온다. -->
    <div class="h-3 w-full" style="background: var(--color-grass)"></div>
    <Mole
      motion="peek"
      scale={7}
      ms={420}
      label="모루"
      class="absolute right-10 bottom-3 hidden md:block"
    />
  </div>

  <!-- ── 세 가지 ──────────────────────────────────────── -->
  <Band tone={0} grit>
    <h2 class="text-[24px] font-bold md:text-[32px]">{h.threeTitle}</h2>
    <ol class="mt-10 grid gap-5 md:grid-cols-3">
      {
        h.three.map(([name, what], i) => (
          <li class="px bg-[var(--color-ink)] p-6" style="--px-c: var(--color-soil-line)">
            <p class="font-mono text-[12px] text-[var(--color-sand)]">{String(i + 1).padStart(2, '0')}</p>
            <p class="mt-3 text-[17px] font-semibold">{name}</p>
            <p class="mt-3 text-[14px] leading-relaxed text-[var(--color-muted)]">{what}</p>
          </li>
        ))
      }
    </ol>
  </Band>

  <!-- ── 이럴 때 ──────────────────────────────────────── -->
  <Band tone={0} grit edge>
    <h2 class="text-[24px] font-bold md:text-[32px]">{h.whenTitle}</h2>
    <p class="mt-3 text-[15px] text-[var(--color-muted)]">{h.whenLede}</p>

    <ul class="mt-8 grid gap-x-10 gap-y-4 md:grid-cols-2">
      {
        h.when.map((line) => (
          <li class="flex gap-3 text-[15px] leading-relaxed">
            <span class="mt-[9px] h-[3px] w-4 shrink-0" style="background: var(--color-soil-line)" />
            <span class="text-[#e5dcd0]">{line}</span>
          </li>
        ))
      }
    </ul>
  </Band>

  <!-- ── 이렇게 생겼어요 ──────────────────────────────── -->
  <Band tone={1} grit edge>
    <h2 class="text-[24px] font-bold md:text-[32px]">{h.shotTitle}</h2>
    <Shot
      class="mt-8"
      lang={lang}
      name="scan"
      alt={h.shotAlt}
    />
  </Band>

  <!-- ── 실제 출력 ────────────────────────────────────── -->
  <Band tone={2} grit edge>
    <div class="grid min-w-0 gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-center">
      <div>
        <h2 class="text-[24px] leading-snug font-bold md:text-[32px]">{ui.why.h1}</h2>

        <div class="px mt-7 bg-[var(--color-ink)] p-5" style="--px-c: var(--color-edge)">
          <p class="font-mono text-[11px] text-[var(--color-faint)]">{h.outputLabel}</p>
          <p class="mt-4 text-[16px] leading-relaxed">
            {h.output1}<br />
            <span style="color: var(--color-apricot)">{h.output2}</span>
          </p>
        </div>
        <p class="mt-4 text-[13px] leading-relaxed text-[var(--color-faint)]">{h.outputWhy}</p>

        <p class="mt-7 max-w-md text-[15.5px] leading-relaxed text-[#e5dcd0]">{ui.why.zeroNote}</p>
        <a
          href={href(lang, 'why')}
          class="mt-7 inline-block text-[14px] text-[var(--color-moss)] hover:underline"
        >
          {ui.why.title} →
        </a>
      </div>
      <Output label="share_summary" code={h.shareSample} />
    </div>
  </Band>

</Layout>
