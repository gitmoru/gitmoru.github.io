---
import Layout from '../components/Layout.astro'
import Band from '../components/Band.astro'
import PageHead from '../components/PageHead.astro'
import { href, type Lang } from '../i18n/config'
import { t } from '../i18n/ui'

interface Props { lang: Lang }
const { lang } = Astro.props
const ui = t(lang)
const w = ui.why

/*
  0 이 나오는 네 경우에 붙는 색.

  앞의 둘은 실제로 아무 일이 없었던 0 이고, 뒤의 둘은 **모르는 0** 이다.
  뒤쪽에 모래색과 살구색을 주는 이유가 이거다. 앱에서도 같은 뜻으로 쓴다.
*/
const ZERO_TONE = [
  'var(--color-moss)',
  'var(--color-moss)',
  'var(--color-sand)',
  'var(--color-apricot)',
]
---

<Layout lang={lang} page="why" title={`${w.title} - gitmoru`} description={w.desc} tone="var(--color-soil-0)">
  <Band tone={0} grit>
    <PageHead title={w.h1} motion="shake" />

    <figure class="mt-12 max-w-2xl">
      <p class="text-[14px] text-[var(--color-muted)]">{w.lede}</p>
      <blockquote
        class="px mt-4 bg-[var(--color-ink)] p-6 text-[19px] leading-relaxed md:text-[22px]"
        style="--px-c: var(--color-soil-line)"
      >
        {w.quote}
      </blockquote>
    </figure>
  </Band>

  <Band tone={1} grit edge>
    <h2 class="text-[24px] font-bold md:text-[30px]">{w.reasonTitle}</h2>
    <div class="mt-8 max-w-2xl space-y-5 text-[16px] leading-relaxed text-[#e5dcd0]">
      <p>{w.reason1}</p>
      <p><strong style="color: var(--color-sand)">{w.reason2}</strong></p>
      <p>{w.reason3}</p>
    </div>
  </Band>

  <Band tone={2} grit edge>
    <h2 class="text-[24px] font-bold md:text-[30px]">{w.zeroTitle}</h2>
    <p class="mt-4 text-[15.5px] text-[#e5dcd0]">{w.zeroLede}</p>

    {/*
      한 줄에 하나씩, 0 을 세로로 줄 세운다.

      이 자리에서 하려는 말은 "넷 다 화면에는 똑같이 0 으로 뜬다" 이다.
      카드 넷으로 흩어 놓으면 서로 다른 항목 넷으로 읽히고, 정작 그 말이 안 보인다.
      왼쪽 끝에 0 이 딱 맞아떨어져 있으면 읽기 전에 눈으로 먼저 알아본다.

      색은 앱이 상태를 칠하는 그대로다. 이끼색은 확인한 것, 모래색은 확인 못 한 것,
      살구색은 사람이 읽어야 할 것이다. 화면에서 이미 그 뜻이라 새로 배울 게 없다.
    */}
    <ul class="mt-10">
      {w.zero.map(([name, what], i) => (
        <li
          class="flex items-baseline gap-5 py-5 sm:gap-7"
          style={
            i === 0
              ? undefined
              : 'border-top: 1px solid color-mix(in srgb, var(--color-soil-line) 45%, transparent)'
          }
        >
          {/*
            테두리 상자를 씌우면 0 이 아니라 상자가 먼저 보인다.
            여기서 필요한 건 넷이 줄 맞아 서 있는 모습이지 액자가 아니다.

            고정폭 글꼴을 안 쓴다. JetBrains Mono 는 0 안에 점을 찍어서
            숫자가 아니라 기호처럼 보인다. 여기서는 그냥 0 이어야 한다.
          */}
          <span
            class="w-9 shrink-0 text-center text-[30px] leading-none font-semibold tabular-nums"
            style={`color: ${ZERO_TONE[i]}`}
            aria-hidden="true"
          >
            0
          </span>

          <div class="min-w-0 flex-1 sm:flex sm:items-baseline sm:gap-6">
            <p
              class="w-[7.5rem] shrink-0 text-[16.5px] font-semibold"
              style={`color: ${ZERO_TONE[i]}`}
            >
              {name}
            </p>
            <p class="mt-1.5 text-[15px] leading-relaxed text-[var(--color-muted)] sm:mt-0">
              {what}
            </p>
          </div>
        </li>
      ))}
    </ul>

    <p class="mt-8 max-w-2xl text-[15.5px] leading-relaxed" style="color: var(--color-apricot)">
      {w.zeroNote}
    </p>
  </Band>

  <Band tone={3} grit edge>
    <h2 class="text-[24px] font-bold md:text-[30px]">{w.ruleTitle}</h2>
    <ul class="mt-10 grid gap-5 md:grid-cols-2">
      {w.rules.map(([name, what]) => (
        <li class="px bg-[var(--color-ink)] p-5" style="--px-c: var(--color-soil-line)">
          <p class="text-[15.5px] font-semibold">{name}</p>
          <p class="mt-2 text-[14px] leading-relaxed text-[var(--color-muted)]">{what}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3">
      <a href={href(lang, 'how')} class="text-[15px] text-[var(--color-moss)] hover:underline">
        {w.next} →
      </a>
      {/* 여기까지 읽은 사람은 "이 사람들 뭘 겪은 거지" 가 된다. 그 자리에서만 사연을 내민다. */}
      <a href={href(lang, 'story')} class="text-[15px] text-[var(--color-faint)] hover:text-[var(--color-muted)]">
        {ui.nav.story} →
      </a>
    </div>
  </Band>
</Layout>
